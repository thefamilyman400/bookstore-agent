# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Required. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Optional — defaults shown
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AWS Secrets Manager ───────────────────────────────────────────────────────
# Required. The app fetches GROQ_API_KEY from:
#   arn:aws:secretsmanager:ap-south-1:913524927483:secret:inc-assistant-api-keys-AKmRZ2
#
# In production the IAM role attached to the instance provides credentials
# automatically — do NOT set AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY.
#
# For local development, set the region and ensure your AWS profile has
# secretsmanager:GetSecretValue permission on the ARN above.
AWS_DEFAULT_REGION=ap-south-1

# ── Groq model (optional — defaults to llama-3.3-70b-versatile) ──────────────
# Override if your Groq account has a different model available.
# e.g. GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL=
